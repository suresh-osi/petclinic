            "arn": "arn:aws:iam::633426742056:policy/NewRelic-CloudWatch-Integration-Policy",
            "attachment_count": 1,
            "description": "Policy to allow NewRelic to read CloudWatch Logs, Metrics, and EC2 metadata",
            "id": "arn:aws:iam::633426742056:policy/NewRelic-CloudWatch-Integration-Policy",
            "name": "NewRelic-CloudWatch-Integration-Policy",
